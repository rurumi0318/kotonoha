# ── Google Cloud TTS ───────────────────────────────────────────────
# Voice name for Chirp 3: HD Japanese. Options: Aoede, Charon, Fenrir,
# Kore, Leda, Orus, Puck, Zephyr
TTS_VOICE_NAME=ja-JP-Chirp3-HD-Leda

# Language code (default: ja-JP, no need to change)
TTS_LANGUAGE_CODE=ja-JP

# GCS bucket name for audio cache
TTS_BUCKET_NAME=kotonoha-tts

# ── Frontend audio provider ────────────────────────────────────────
# Set on Cloud Run to activate backend TTS. Leave unset for Web Speech API (Phase 1).
# AUDIO_PROVIDER=cloud_tts
